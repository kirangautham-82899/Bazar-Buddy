# Copy this file to .env.local and fill in your Firebase web app config
# (Firebase console → Project settings → Your apps → Web app).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Optional: UPI ID shown on the payment screen
REACT_APP_UPI_ID=

# Optional: live mandi prices on the Local markets page (server-side only, not REACT_APP_).
# Get a free key at https://data.gov.in (sign up -> My Account -> API key) and add it on Vercel too.
DATA_GOV_IN_API_KEY=

# Recommended: nearby vegetable markets and grocery stores from Google Places (server-side only).
# Google Cloud console -> enable "Places API (New)" -> Credentials -> API key, restricted to that API.
# Without it the Local markets page uses OpenStreetMap, which is free but less reliable.
GOOGLE_PLACES_API_KEY=

# Optional: the in-app chat assistant (server-side only). Create a free key at https://aistudio.google.com/apikey
# Without it the chat button explains that the assistant isn't set up yet.
GEMINI_API_KEY=
# Optional: which Gemini model answers (default gemini-3.5-flash-lite).
GEMINI_MODEL=
