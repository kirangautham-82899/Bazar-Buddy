rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Team members: create admins/{uid} by hand in the Firebase console.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Nobody can make themselves an admin from the app.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Catalog: public to browse, edited by the team.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
    }

    // One cart per vendor: product ids and quantities only.
    match /carts/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.total is number
        && request.resource.data.total > 0;

      // Customers may only cancel, and only before packing.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['placed', 'confirmed']
        && request.resource.data.status == 'cancelled'
        && onlyChanges(['status', 'statusHistory', 'updatedAt']);

      // The team moves orders along; contents and totals stay as placed.
      allow update: if isAdmin()
        && request.resource.data.status in ['placed', 'confirmed', 'packed', 'outForDelivery', 'delivered', 'cancelled']
        && onlyChanges(['status', 'statusHistory', 'updatedAt']);
    }
  }
}
